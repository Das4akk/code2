# ==============================================================================
# COWIO Environment Variables Configuration
# ==============================================================================
# ⚠️  WARNING: This is a TEMPLATE file. NEVER put real secrets here!
#
# 📍 WHERE ARE THE REAL SECRETS?
#    Production:  Vercel → Settings → Environment Variables
#    Local dev:   Copy this file to `.env` and fill in with your own values
#
# 🔗 Vercel Dashboard: https://vercel.com/dashboard
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
APP_URL=https://cowio.vercel.app

# ------------------------------------------------------------------------------
# Firebase RTDB & Admin SDK
# 🔐 Real values: Vercel → Environment Variables → FIREBASE_*
# ------------------------------------------------------------------------------
FIREBASE_DATABASE_URL=https://<your-project>-default-rtdb.firebaseio.com
# FIREBASE_ADMIN_KEY: JSON string сервисного аккаунта Google
# Получить: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_ADMIN_KEY="<paste-your-service-account-json-here>"

# ------------------------------------------------------------------------------
# Client-Side Firebase (Vite)
# 🔐 Real values: Vercel → Environment Variables → VITE_FIREBASE_*
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="<your-firebase-web-api-key>"
VITE_FIREBASE_AUTH_DOMAIN="<your-project>.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://<your-project>-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="<your-project-id>"
VITE_FIREBASE_STORAGE_BUCKET="<your-project>.firebasestorage.app"

# ------------------------------------------------------------------------------
# Email Delivery (SMTP / Gmail App Password)
# 🔐 Real values: Vercel → Environment Variables → SMTP_*
# ⚠️  Use Google App Passwords, NOT your personal account password
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER="<your-email@gmail.com>"
SMTP_PASS="<your-16-char-app-password>"

# ------------------------------------------------------------------------------
# Application Authentication & Cryptography
# 🔐 Real value: Vercel → Environment Variables → AUTH_SECRET
# 🔑 Generate: openssl rand -hex 32
# ------------------------------------------------------------------------------
AUTH_SECRET="<generate-a-32-char-random-secret>"

# ------------------------------------------------------------------------------
# Platega Payment Gateway
# 🔐 Real values: Vercel → Environment Variables → PLATEGA_*
# ------------------------------------------------------------------------------
PLATEGA_API_KEY="<your-platega-api-key>"
PLATEGA_MERCHANT_ID="<your-platega-merchant-id>"
PLATEGA_WEBHOOK_SECRET="<your-platega-webhook-secret>"
PREMIUM_PRICE_RUB=179

# Создатель (creator) — обязательно ваш email
