{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid || root.child('admins').child(auth.uid).exists()",
        ".write": false,
        "profile": {
          ".write": "$uid === auth.uid"
        },
        "role": {
          ".write": false
        },
        "premium": {
          ".write": false
        },
        "lumens": {
          ".write": false
        },
        "private": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        }
      }
    },
    "admins": {
      ".read": "root.child('admins').child(auth.uid).exists()",
      ".write": false
    },
    "usernames": {
      ".read": true,
      "$username": {
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null && (data.child('isPrivate').val() !== true || data.child('members').child(auth.uid).exists() || data.child('owner').val() === auth.uid)",
        ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid || data.child('members').child(auth.uid).exists())"
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()"
      }
    },
    "payments_log": {
      ".read": "root.child('admins').child(auth.uid).exists()",
      ".write": false
    }
  }
}
