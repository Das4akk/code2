SMTP_USER=cowiosupport@gmail.com
SMTP_PASS=your_app_password_here

# COWIO Premium (LAVA) — https://lava.top → Интеграции → Public API
LAVA_API_KEY=your_lava_api_key
LAVA_OFFER_ID=your_product_offer_uuid
# Ключ для проверки webhook (укажите тот же в настройках webhook LAVA)
# LAVA_WEBHOOK_KEY=your_webhook_auth_key
APP_BASE_URL=https://your-domain.vercel.app
PREMIUM_PRICE_RUB=179

# Для локального теста без оплаты (только dev!)
# PREMIUM_SANDBOX_AUTO=true

# Секрет для ручной выдачи Premium: POST /api/premium/grant + header x-premium-admin-secret
# PREMIUM_ADMIN_SECRET=your_random_secret
