{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "includeFiles": "api/**",
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|webp|svg|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/custom-auth/(.*)", "destination": "/api/custom-auth.js?action=$1" },
    { "source": "/api/custom-auth", "destination": "/api/custom-auth.js" },
    { "source": "/api/health", "destination": "/api/health.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/((?!api/|assets/|css/|js/|partials/|public/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
